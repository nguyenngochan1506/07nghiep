generator client {
  provider = "prisma-client"
  output   = "../generated"
  moduleFormat = "esm"
  runtime = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum CompanySize {
  STARTUP
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum SalaryType {
  HOURLY
  MONTHLY
  YEARLY
}

enum WorkType {
  REMOTE
  HYBRID
  ONSITE
}

enum JobType {
  FULLTIME
  PARTIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MIDDLE
  SENIOR
  LEAD
  EXECUTIVE
}

enum JobStatus {
  DRAFT
  PENDING_APPROVAL
  OPEN
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  PENDING
  VIEWED
  SHORTLISTED
  INTERVIEWING
  OFFERED
  REJECTED
  WITHDRAWN
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_STATUS
  MESSAGE
  JOB_ALERT
  SYSTEM
}

// ============================================
// CUSTOM MODELS
// ============================================

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  headline    String?
  summary     String?  @db.Text
  skills      String[]
  experience  Json?
  education   Json?
  resumeUrl   String?
  portfolioUrl String?
  location    String?
  phone       String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id          String       @id @default(cuid())
  userId      String       @unique
  name        String
  description String?      @db.Text
  logoUrl     String?
  website     String?
  industry    String?
  companySize CompanySize?
  foundedYear Int?
  location    String?
  verified    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs  Job[]
}

model Job {
  id                 String           @id @default(cuid())
  organizationId    String
  title              String
  description        String           @db.Text
  requirements       String?          @db.Text
  benefits           String?          @db.Text
  salaryMin          Decimal?         @db.Decimal(12, 2)
  salaryMax          Decimal?         @db.Decimal(12, 2)
  salaryType         SalaryType?
  salaryNegotiable    Boolean          @default(false)
  location           String
  workType           WorkType
  jobType            JobType
  experienceLevel    ExperienceLevel   @default(ENTRY)
  status             JobStatus         @default(DRAFT)
  publishedAt        DateTime?
  expiresAt          DateTime?
  views              Int               @default(0)
  applicationsCount  Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applications  Application[]
  savedJobs     SavedJob[]
  conversations Conversation[]
  skills        JobSkill[]

  @@index([status, publishedAt])
  @@index([organizationId, status])
  @@index([workType, jobType])
  @@index([location])
}

model Application {
  id          String            @id @default(cuid())
  jobId       String
  candidateId String
  status      ApplicationStatus @default(PENDING)
  coverLetter String?           @db.Text
  resumeUrl   String?
  answers     Json?
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  notes       String?           @db.Text
  histories   ApplicationHistory[]

  job       Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate User   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([candidateId, status])
  @@index([appliedAt])
  @@unique([jobId, candidateId])
}

model ApplicationHistory {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?            @db.Text
  changedById   String?
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model SavedJob {
  id      String   @id @default(cuid())
  userId  String
  jobId   String
  savedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  data      Json?
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model NotificationPreference {
  id           String           @id @default(cuid())
  userId       String
  type         NotificationType
  pushEnabled  Boolean          @default(true)
  emailEnabled Boolean          @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model Conversation {
  id            String    @id @default(cuid())
  jobId         String?
  employerId    String
  candidateId   String
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  job       Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  employer  User         @relation("EmployerConversations", fields: [employerId], references: [id], onDelete: Cascade)
  candidate User         @relation("CandidateConversations", fields: [candidateId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([employerId, candidateId, jobId])
}

model Message {
  id              String    @id @default(cuid())
  conversationId  String
  senderId        String
  content         String    @db.Text
  read            Boolean   @default(false)
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model JobSkill {
  id    String @id @default(cuid())
  jobId String
  skill String

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, skill])
}
