generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum CompanySize {
  STARTUP
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum SalaryType {
  HOURLY
  MONTHLY
  YEARLY
}

enum WorkType {
  REMOTE
  HYBRID
  ONSITE
}

enum JobType {
  FULLTIME
  PARTIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MIDDLE
  SENIOR
  LEAD
  EXECUTIVE
}

enum JobStatus {
  DRAFT
  PENDING_APPROVAL
  OPEN
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  PENDING
  VIEWED
  SHORTLISTED
  INTERVIEWING
  OFFERED
  REJECTED
  WITHDRAWN
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_STATUS
  MESSAGE
  JOB_ALERT
  SYSTEM
  INTERVIEW_INVITATION
}

enum InterviewStatus {
  SCHEDULED
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum ModerationAction {
  APPROVE
  REJECT
  REQUEST_CHANGES
  REMOVE_CONTENT
  WARN_USER
  BAN_USER
  DISMISS_REPORT
}

enum ReportType {
  INAPPROPRIATE_CONTENT
  SPAM
  SCAM_FRAUD
  DUPLICATE_POSTING
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ContentType {
  JOB
  USER
  MESSAGE
}

// ============================================
// CUSTOM MODELS
// ============================================

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  headline     String?
  summary      String?
  skills       String[]
  experience   Json?
  education    Json?
  resumeUrl    String?
  portfolioUrl String?
  location     String?
  phone        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id          String       @id @default(cuid())
  userId      String       @unique
  name        String
  description String?
  logoUrl     String?
  website     String?
  industry    String?
  companySize CompanySize?
  foundedYear Int?
  location    String?
  verified    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  jobs        Job[]
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id                String          @id @default(cuid())
  organizationId    String
  title             String
  description       String
  requirements      String?
  benefits          String?
  salaryMin         Decimal?        @db.Decimal(12, 2)
  salaryMax         Decimal?        @db.Decimal(12, 2)
  salaryType        SalaryType?
  salaryNegotiable  Boolean         @default(false)
  location          String
  workType          WorkType
  jobType           JobType
  experienceLevel   ExperienceLevel @default(ENTRY)
  status            JobStatus       @default(DRAFT)
  publishedAt       DateTime?
  expiresAt         DateTime?
  views             Int             @default(0)
  applicationsCount Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  applications      Application[]
  conversations     Conversation[]
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skills            JobSkill[]
  savedJobs         SavedJob[]
  moderationHistory ModerationHistory[]

  @@index([status, publishedAt])
  @@index([organizationId, status])
  @@index([workType, jobType])
  @@index([location])
}

model Application {
  id          String            @id @default(cuid())
  jobId       String
  candidateId String
  status      ApplicationStatus @default(PENDING)
  coverLetter String?
  resumeUrl   String?
  answers     Json?
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  notes       String?           @db.Text
  histories   ApplicationHistory[]
  interviews  Interview[]

  candidate   User              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([candidateId, status])
  @@index([appliedAt])
  @@unique([jobId, candidateId])
}
model ApplicationHistory {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?            @db.Text
  changedById   String?
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model Interview {
  id              String          @id @default(cuid())
  applicationId   String
  scheduledAt     DateTime
  durationMinutes Int             @default(60)
  location        String?
  meetingLink     String?
  notes           String?         @db.Text
  status          InterviewStatus @default(SCHEDULED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model SavedJob {
  id      String   @id @default(cuid())
  userId  String
  jobId   String
  savedAt DateTime @default(now())
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model NotificationPreference {
  id           String           @id @default(cuid())
  userId       String
  type         NotificationType
  pushEnabled  Boolean          @default(true)
  emailEnabled Boolean          @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model Conversation {
  id            String    @id @default(cuid())
  jobId         String?
  employerId    String
  candidateId   String
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  candidate     User      @relation("CandidateConversations", fields: [candidateId], references: [id], onDelete: Cascade)
  employer      User      @relation("EmployerConversations", fields: [employerId], references: [id], onDelete: Cascade)
  job           Job?      @relation(fields: [jobId], references: [id])
  messages      Message[]

  @@unique([employerId, candidateId, jobId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model JobSkill {
  id    String @id @default(cuid())
  jobId String
  skill String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, skill])
}

model ModerationHistory {
  id          String           @id @default(cuid())
  jobId       String?
  moderatorId String
  action      ModerationAction
  reason      String?          @db.Text
  feedback    String?          @db.Text
  createdAt   DateTime         @default(now())

  job       Job?  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  moderator User  @relation("ModeratorActions", fields: [moderatorId], references: [id])

  @@index([jobId, createdAt])
  @@index([moderatorId, createdAt])
}

model Report {
  id          String       @id @default(cuid())
  contentType ContentType
  contentId   String
  reporterId  String
  reportType  ReportType
  description String?      @db.Text
  status      ReportStatus @default(PENDING)
  resolvedAt  DateTime?
  resolvedBy  String?
  resolution  String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  reporter User  @relation("UserReports", fields: [reporterId], references: [id])
  resolver User? @relation("ResolvedReports", fields: [resolvedBy], references: [id])

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([contentType, contentId])
}
