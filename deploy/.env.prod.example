# Public URLs used by the browser.
# Replace 127.0.0.1 with your VPS IP while testing without Nginx.
PUBLIC_SERVER_URL=http://127.0.0.1:3000
CANDIDATE_APP_URL=http://127.0.0.1:3003
EMPLOYER_APP_URL=http://127.0.0.1:3002

# Published host ports.
SERVER_PORT=3000
ADMIN_PORT=3001
EMPLOYER_PORT=3002
CANDIDATE_PORT=3003

# Database container credentials.
POSTGRES_DB=07nghiep
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Server runtime env.
# In compose, DATABASE_URL is derived from POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB.
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
CORS_ORIGIN=http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003
NODE_ENV=production
SEED_DEMO_USERS=true
REDIS_URL=redis://redis:6379

# Optional integrations. Keep empty for a basic demo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
RESEND_API_KEY=
RESEND_FROM=
ANTHROPIC_API_KEY=
ANTHROPIC_URL=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
AI_WORKER_CONCURRENCY=1
AI_JOB_MAX_ATTEMPTS=3
AI_JOB_TIMEOUT_MS=120000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
